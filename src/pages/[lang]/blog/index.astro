---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PortfolioLayout.astro';
import { copy, languages, type Language } from '~/data/portfolio';
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Language;
const t = copy[lang];
const posts = (
  await getCollection('articles', ({ data }) => data.lang === lang && !data.draft && data.publishDate <= new Date())
).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Layout lang={lang} title={t.nav[4] + ' — Osvaldo Cintra García'}>
  <section class="detail-hero container">
    <a href={`/${lang}/`} class="text-link light"><Icon name="tabler:arrow-left" aria-hidden="true" />{t.back}</a><p
      class="eyebrow light"
    >
      {t.journalLabel}
    </p><h1 data-hero>{t.journalTitle.split('\n').map((line) => <span>{line}</span>)}</h1><p class="detail-intro">
      {t.journalText}
    </p>
  </section>
  <section class="light-shell blog-shell">
    <div class="container section">
      {
        posts.length ? (
          <div class="article-list">
            {posts.map((post) => (
              <a class="article-card" href={`/${lang}/blog/${post.id.replace(/^(en|es)\//, '')}/`}>
                <time datetime={post.data.publishDate.toISOString()}>
                  {post.data.publishDate.toLocaleDateString(lang, { dateStyle: 'long', timeZone: 'UTC' })}
                </time>
                <h2>{post.data.title}</h2>
                <p>{post.data.excerpt}</p>
                <Icon name="tabler:arrow-up-right" aria-hidden="true" />
              </a>
            ))}
          </div>
        ) : (
          <div class="empty-page">
            <>
              <Icon name="tabler:pencil" aria-hidden="true" />
              <h2>{t.journalEmpty}</h2>
              <p>{t.journalSoon}</p>
              <a class="button button-outline" href={`/${lang}/#work`}>
                {t.explore}
                <Icon name="tabler:arrow-up-right" aria-hidden="true" />
              </a>
            </>
          </div>
        )
      }
    </div>
  </section>
</Layout>
