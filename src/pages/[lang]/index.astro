---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PortfolioLayout.astro';
import ProjectArt from '~/components/portfolio/ProjectArt.astro';
import { copy, profile, projects, experience, toolkit, languages, type Language } from '~/data/portfolio';
import { getCollection } from 'astro:content';
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Language;
const t = copy[lang];
const posts = (
  await getCollection('articles', ({ data }) => data.lang === lang && !data.draft && data.publishDate <= new Date())
)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 2);
---

<Layout lang={lang}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-glow" aria-hidden="true"></div><div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-copy container">
      <p class="hero-kicker" data-hero><span class="status-dot"></span>{t.role}</p>
      <h1 id="hero-title" class="hero-title" data-hero>{t.headline.map((line) => <span>{line}</span>)}</h1>
      <p class="hero-intro" data-hero>{t.intro}</p>
      <div class="hero-actions" data-hero>
        <a class="button button-green" href="#work"
          >{t.explore}<Icon name="tabler:arrow-down-right" aria-hidden="true" /></a
        ><a href={profile.cv} download class="text-link light" data-astro-reload
          >{t.download}<Icon name="tabler:download" aria-hidden="true" /></a
        >
      </div>
    </div>
    <div class="hero-gallery-wrap">
      <div
        class="hero-gallery"
        id="hero-gallery"
        tabindex="0"
        role="region"
        aria-label={lang === 'en' ? 'Featured projects' : 'Proyectos destacados'}
      >
        {
          projects.map((project, i) => (
            <figure class="hero-project" data-hero-card>
              <>
                <a href={`/${lang}/work/${project.slug}/`} aria-label={project.name + ' — ' + t.caseLink}>
                  <ProjectArt kind={project.kind} id={'hero-' + project.slug} />
                  <div class="hero-project-overlay">
                    <>
                      <div>
                        <>
                          <span>{project[lang].category}</span>
                          <h2>{project.name}</h2>
                        </>
                      </div>
                      <span class="circle-arrow">
                        <Icon name="tabler:arrow-up-right" aria-hidden="true" />
                      </span>
                    </>
                  </div>
                </a>
                <figcaption>
                  {t.concept}
                  <span>0{i + 1}</span>
                </figcaption>
              </>
            </figure>
          ))
        }
      </div>
      <div class="gallery-meta container">
        <span><Icon name="tabler:map-pin" aria-hidden="true" />{t.location}</span><div class="gallery-controls">
          <button
            type="button"
            data-gallery-direction="-1"
            aria-controls="hero-gallery"
            aria-label={lang === 'en' ? 'Previous project' : 'Proyecto anterior'}
            ><Icon name="tabler:arrow-left" aria-hidden="true" /></button
          ><button
            type="button"
            data-gallery-direction="1"
            aria-controls="hero-gallery"
            aria-label={lang === 'en' ? 'Next project' : 'Siguiente proyecto'}
            ><Icon name="tabler:arrow-right" aria-hidden="true" /></button
          >
        </div>
      </div>
    </div>
    <div class="discipline-strip container" aria-label={lang === 'en' ? 'Areas of expertise' : 'Especialidades'}>
      {
        t.disciplines.map((label) => (
          <span>
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M10 1v18M1 10h18M4 4l12 12M4 16 16 4" stroke="currentColor" stroke-width="1.5" />
            </svg>
            {label}
          </span>
        ))
      }
    </div>
  </section>

  <div class="light-shell">
    <section id="about" class="section container about-section">
      <div class="section-heading">
        <p class="eyebrow">{t.aboutLabel}</p><h2 data-reveal>
          {t.aboutTitle.split('\n').map((line) => <span>{line}</span>)}
        </h2>
      </div>
      <div class="about-copy" data-reveal>
        {t.about.map((paragraph) => <p>{paragraph}</p>)}<a
          class="text-link"
          href={profile.linkedin}
          target="_blank"
          rel="noopener noreferrer">LinkedIn<Icon name="tabler:arrow-up-right" aria-hidden="true" /></a
        >
      </div>
      <div class="toolkit">
        <h3>{t.skills}</h3><div class="skill-tags">{toolkit.map((skill) => <span>{skill}</span>)}</div>
      </div>
    </section>

    <section id="work" class="work-section section">
      <div class="container">
        <div class="section-top">
          <div class="section-heading">
            <p class="eyebrow">{t.workLabel}</p><h2 data-reveal>
              {t.workTitle.split('\n').map((line) => <span>{line}</span>)}
            </h2>
          </div><p class="section-description">{t.workIntro}</p>
        </div>
        <div class="project-list">
          {
            projects.map((project, i) => (
              <article class="work-card" data-reveal>
                <a
                  class="work-art-link"
                  href={`/${lang}/work/${project.slug}/`}
                  aria-label={project.name + ' — ' + t.caseLink}
                >
                  <ProjectArt kind={project.kind} id={'work-' + project.slug} />
                </a>
                <div class="work-card-copy">
                  <>
                    <div class="project-meta">
                      <>
                        <span>{project[lang].category}</span>
                        <span>0{i + 1}</span>
                      </>
                    </div>
                    <h3>
                      <a href={`/${lang}/work/${project.slug}/`}>
                        {project.name}
                        <span>{project[lang].title.split('\n').join(' ')}</span>
                      </a>
                    </h3>
                    <p>{project[lang].summary}</p>
                    <div class="project-stack">
                      {project.stack.slice(0, 4).map((item) => (
                        <span>{item}</span>
                      ))}
                    </div>
                    <a class="text-link" href={`/${lang}/work/${project.slug}/`}>
                      {t.caseLink}
                      <Icon name="tabler:arrow-up-right" aria-hidden="true" />
                    </a>
                  </>
                </div>
                <p class="art-disclaimer">{t.concept}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="services" class="section container">
      <div class="section-top">
        <div class="section-heading">
          <p class="eyebrow">{t.servicesLabel}</p><h2 data-reveal>
            {t.servicesTitle.split('\n').map((line) => <span>{line}</span>)}
          </h2>
        </div><a href={`mailto:${profile.email}`} class="button button-outline"
          >{t.contact}<Icon name="tabler:arrow-up-right" aria-hidden="true" /></a
        >
      </div>
      <div class="services-grid">
        {
          t.services.map((service) => (
            <article class="service-item" data-reveal>
              <>
                <div class="service-icon">
                  <Icon name={service.icon} aria-hidden="true" />
                </div>
                <h3>{service.title}</h3>
                <p>{service.text}</p>
                <span class="service-tags">{service.tags}</span>
              </>
            </article>
          ))
        }
      </div>
    </section>

    <section class="process-section section container" id="process">
      <div class="section-heading">
        <p class="eyebrow">{t.processLabel}</p><h2 data-reveal>
          {t.processTitle.split('\n').map((line) => <span>{line}</span>)}
        </h2>
      </div>
      <div class="process-content" data-process>
        <div class="process-tabs" aria-label={t.processLabel}>
          {
            t.steps.map((step, i) => (
              <button id={'step-tab-' + i} type="button" data-step={i} aria-controls={'step-panel-' + i}>
                <span>0{i + 1}</span>
                {step.title}
              </button>
            ))
          }
        </div>
        {
          t.steps.map((step, i) => (
            <div id={'step-panel-' + i} class="process-panel" data-step-panel={i} aria-labelledby={'step-tab-' + i}>
              <>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </>
            </div>
          ))
        }
      </div>
    </section>

    <section id="experience" class="experience-section section container">
      <div class="section-top">
        <div class="section-heading">
          <p class="eyebrow">{t.experienceLabel}</p><h2 data-reveal>
            {t.experienceTitle.split('\n').map((line) => <span>{line}</span>)}
          </h2>
        </div><a class="text-link" href={profile.cv} download data-astro-reload
          >{t.download}<Icon name="tabler:download" aria-hidden="true" /></a
        >
      </div>
      <div class="experience-list">
        {
          experience.map((job) => (
            <article class="experience-row" data-reveal>
              <>
                <div>
                  <>
                    <p class="job-company">
                      {job.company}
                      {job.current && <span class="current-dot" aria-label={t.present} />}
                    </p>
                    <h3>{job[lang].role}</h3>
                  </>
                </div>
                <div>
                  <>
                    <p>{job[lang].description}</p>
                    <div class="job-details">
                      <>
                        <span>
                          {job.dates}
                          {job.current && ' ' + t.present}
                        </span>
                        <span>{lang === 'es' ? job.location.replace('Havana', 'La Habana') : job.location}</span>
                      </>
                    </div>
                  </>
                </div>
              </>
            </article>
          ))
        }
      </div>
      <div class="education-row">
        <Icon name="tabler:school" aria-hidden="true" /><div><h3>{t.education}</h3><p>{t.university}</p></div>
      </div>
    </section>

    <section id="journal" class="journal-section section">
      <div class="container">
        <div class="section-top">
          <div class="section-heading">
            <p class="eyebrow">{t.journalLabel}</p><h2 data-reveal>
              {t.journalTitle.split('\n').map((line) => <span>{line}</span>)}
            </h2>
          </div><p class="section-description">{t.journalText}</p>
        </div>
        {
          posts.length ? (
            <div class="article-list">
              {posts.map((post) => (
                <a class="article-card" href={`/${lang}/blog/${post.id.replace(/^(en|es)\//, '')}/`}>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.excerpt}</p>
                  <Icon name="tabler:arrow-up-right" aria-hidden="true" />
                </a>
              ))}
            </div>
          ) : (
            <div class="journal-empty">
              <>
                <div class="journal-symbol" aria-hidden="true">
                  <>
                    <Icon name="tabler:code" />
                    <span class="writing-cursor" />
                  </>
                </div>
                <div>
                  <>
                    <h3>{t.journalEmpty}</h3>
                    <p>{t.journalSoon}</p>
                  </>
                </div>
                <a class="text-link" href={`/${lang}/blog/`}>
                  {t.journalLink}
                  <Icon name="tabler:arrow-up-right" aria-hidden="true" />
                </a>
              </>
            </div>
          )
        }
      </div>
    </section>
  </div>
</Layout>
