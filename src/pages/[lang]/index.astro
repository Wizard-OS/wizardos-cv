---
import Layout from '~/layouts/PortfolioLayout.astro';
import Hero from '~/components/portfolio/Hero.astro';
import About from '~/components/portfolio/About.astro';
import Projects from '~/components/portfolio/Projects.astro';
import Services from '~/components/portfolio/Services.astro';
import Process from '~/components/portfolio/Process.astro';
import Experience from '~/components/portfolio/Experience.astro';
import Journal from '~/components/portfolio/Journal.astro';
import { languages, type Language } from '~/data/portfolio';
import { getCollection } from 'astro:content';
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Language;
const posts = (
  await getCollection('articles', ({ data }) => data.lang === lang && !data.draft && data.publishDate <= new Date())
)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 2);
---

<Layout lang={lang}>
  <Hero lang={lang} />
  <div class="light-shell">
    <About lang={lang} />
    <Projects lang={lang} />
    <Services lang={lang} />
    <Process lang={lang} />
    <Experience lang={lang} />
    <Journal lang={lang} posts={posts} />
  </div>
</Layout>
