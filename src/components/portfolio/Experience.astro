---
import { Icon } from 'astro-icon/components';
import { copy, profile, experience, type Language } from '~/data/portfolio';
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const t = copy[lang];
---

<section id="experience" class="experience-section section container">
  <div class="section-top">
    <div class="section-heading">
      <p class="eyebrow">{t.experienceLabel}</p><h2 data-reveal>
        {t.experienceTitle.split('\n').map((line) => <span>{line}</span>)}
      </h2>
    </div><a class="text-link" href={profile.cv} download data-astro-reload
      >{t.download}<Icon name="tabler:download" aria-hidden="true" /></a
    >
  </div>
  <div class="experience-list">
    {
      experience.map((job) => (
        <article class="experience-row" data-reveal>
          <div>
            <p class="job-company">
              {job.company}
              {job.current && <span class="current-dot" aria-label={t.present} />}
            </p>
            <h3>{job[lang].role}</h3>
          </div>
          <div>
            <p>{job[lang].description}</p>
            <div class="job-details">
              <span>
                {job.dates}
                {job.current && ' ' + t.present}
              </span>
              <span>{lang === 'es' ? job.location.replace('Havana', 'La Habana') : job.location}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
  <div class="education-row">
    <Icon name="tabler:school" aria-hidden="true" /><div><h3>{t.education}</h3><p>{t.university}</p></div>
  </div>
</section>
