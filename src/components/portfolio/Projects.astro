---
import { Icon } from 'astro-icon/components';
import { copy, projects, type Language } from '~/data/portfolio';
import ProjectArt from './ProjectArt.astro';
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const t = copy[lang];
---

<section id="work" class="work-section section">
  <div class="container">
    <div class="section-top">
      <div class="section-heading">
        <p class="eyebrow">{t.workLabel}</p><h2 data-reveal>
          {t.workTitle.split('\n').map((line) => <span>{line}</span>)}
        </h2>
      </div><p class="section-description">{t.workIntro}</p>
    </div>
    <div class="project-list">
      {
        projects.map((project, i) => (
          <article class="work-card" data-reveal>
            <a
              class="work-art-link"
              href={`/${lang}/work/${project.slug}/`}
              aria-label={project.name + ' — ' + t.caseLink}
            >
              <ProjectArt kind={project.kind} id={'work-' + project.slug} />
            </a>
            <div class="work-card-copy">
              <div class="project-meta">
                <span>{project[lang].category}</span>
                <span>0{i + 1}</span>
              </div>
              <h3>
                <a href={`/${lang}/work/${project.slug}/`}>
                  {project.name}
                  <span>{project[lang].title.split('\n').join(' ')}</span>
                </a>
              </h3>
              <p>{project[lang].summary}</p>
              <div class="project-stack">
                {project.stack.slice(0, 4).map((item) => (
                  <span>{item}</span>
                ))}
              </div>
              <a class="text-link" href={`/${lang}/work/${project.slug}/`}>
                {t.caseLink}
                <Icon name="tabler:arrow-up-right" aria-hidden="true" />
              </a>
            </div>
            <p class="art-disclaimer">{t.concept}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
